  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Operators directory with role and branch permissions."
    },
    "/rotations/{rotationId}": {
      "schema": "Rotation",
      "description": "Tire rotation records per branch."
    },
    "/alignments/{alignmentId}": {
      "schema": "Alignment",
      "description": "Alignment services per branch."
    },
    "/calibrations/{calibrationId}": {
      "schema": "Calibration",
      "description": "Calibration records per branch."
    },
    "/balancings/{balancingId}": {
      "schema": "Balancing",
      "description": "Balancing records per branch."
    },
    "/inventoryItems/{inventoryItemId}": {
      "schema": "InventoryItem",
      "description": "Borracharia inventory products database catalog per branch."
    },
    "/treadMeasurements/{treadMeasurementId}": {
      "schema": "TreadMeasurement",
      "description": "Tire depth tread measurements."
    },
    "/tireMovements/{tireMovementId}": {
      "schema": "TireMovement",
      "description": "Movement of tires on vehicle slots."
    }
  }
