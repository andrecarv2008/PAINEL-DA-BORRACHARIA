{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Registered profile for system operators controlling corporate access and branches.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The unique Firebase Auth identifier." },
        "email": { "type": "string", "description": "Operator email address." },
        "role": { "type": "string", "enum": ["MASTER", "GERENTE", "OPERADOR"] },
        "branchId": { "type": "string", "enum": ["MATRIZ", "CD_116", "CD_88", "CD_105", "CD_333"] },
        "branchName": { "type": "string" },
        "cargo": { "type": "string" },
        "status": { "type": "string", "enum": ["Ativo", "Inativo"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "branchId", "branchName", "cargo", "status", "createdAt", "updatedAt"]
    },
    "Rotation": {
      "title": "Tire Rotation Record",
      "description": "Tracks tire rotation and replacement events per vehicle and branch.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "veiculo": { "type": "string" },
        "pneuRetirado": { "type": "string" },
        "pneuInstalado": { "type": "string" },
        "fluxo": { "type": "string" },
        "data": { "type": "string", "format": "date" },
        "status": { "type": "string" },
        "fogoPneu": { "type": "string", "description": "Rastreio único do fogo do pneu." },
        "branchId": { "type": "string" },
        "branchName": { "type": "string" },
        "createdBy": { "type": "string" },
        "userRole": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "veiculo", "pneuRetirado", "pneuInstalado", "fluxo", "data", "status", "fogoPneu", "branchId", "branchName", "createdBy", "userRole", "createdAt", "updatedAt"]
    },
